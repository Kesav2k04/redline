<?xml version="1.0" encoding="utf-8"?>
<!-- The v2 launcher mark with its red line drawn in by the pen, so a cold start opens with the
     same gesture as the underline on the first screen. The page is the launcher foreground
     unchanged. The launcher draws the red line as a filled bar with round ends; here it is the
     same bar as a 6.5 wide round-capped stroke along its centre line (x 43.25 to 75.76, y 58.25),
     because only a stroke can be trimmed. Android 12 and later only. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <path android:fillColor="#F2F3F5" android:fillType="evenOdd"
                android:pathData="M38.8,27.64H63.2C67.34,27.64 68.86,29.15 68.86,33.3V52.35H43.25A5.9,5.9 0 0 0 43.25,64.15H68.86V74.2C68.86,78.35 67.34,79.86 63.2,79.86H38.8C34.66,79.86 33.14,78.35 33.14,74.2V33.3C33.14,29.15 34.66,27.64 38.8,27.64ZM42.25,34.34H59.75A2.4,2.4 0 0 1 59.75,39.14H42.25A2.4,2.4 0 0 1 42.25,34.34ZM42.25,43.35H59.75A2.4,2.4 0 0 1 59.75,48.15H42.25A2.4,2.4 0 0 1 42.25,43.35ZM42.25,68.36H50.75A2.4,2.4 0 0 1 50.75,73.16H42.25A2.4,2.4 0 0 1 42.25,68.36Z"/>
            <path android:name="redline" android:strokeColor="#FF4D4D" android:strokeWidth="6.5" android:strokeLineCap="round" android:trimPathEnd="0"
                android:pathData="M43.25,58.25H75.76"/>
        </vector>
    </aapt:attr>
    <target android:name="redline">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="80" android:duration="420"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
